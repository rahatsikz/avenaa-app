{
  "expo": {
    "name": "avenaa",
    "slug": "avenaa",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/avenaa-gpt.png",
    "scheme": "avenaaa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.avenaa",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/avenaa-gpt.png",
        "backgroundColor": "#ffffff",
        "titleBarHidden": true
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/avenaa-gpt.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "titleBarHidden": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "522cfe54-f895-4224-8400-43ac0e365cc9"
      }
    }
  }
}
